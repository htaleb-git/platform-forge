#!/usr/bin/env bash
set -euo pipefail

set -a
source "{{ restic_environment_file }}"
set +a

METRICS_DIR="{{ restic_metrics_dir }}"
METRICS_FILE="${METRICS_DIR}/restic_maintenance.prom"
METRICS_TMP="${METRICS_FILE}.tmp.$$"
START_TS="$(date +%s)"
LAST_SUCCESS_TS=0

if [[ -f "${METRICS_FILE}" ]]; then
  LAST_SUCCESS_TS="$(awk '/^platform_forge_restic_maintenance_last_success_timestamp / {print $2}' "${METRICS_FILE}" | tail -1)"
  LAST_SUCCESS_TS="${LAST_SUCCESS_TS:-0}"
fi

write_metrics() {
  local exit_code="$1"
  local end_ts status last_success
  set +e
  [[ -d "${METRICS_DIR}" ]] || return 0
  end_ts="$(date +%s)"
  status=0
  last_success="${LAST_SUCCESS_TS}"
  if [[ "${exit_code}" -eq 0 ]]; then status=1; last_success="${end_ts}"; fi
  cat > "${METRICS_TMP}" <<EOF
# HELP platform_forge_restic_maintenance_status Last Restic retention maintenance status (1=success, 0=failure)
# TYPE platform_forge_restic_maintenance_status gauge
platform_forge_restic_maintenance_status ${status}
# HELP platform_forge_restic_maintenance_last_run_timestamp Unix timestamp of the last maintenance attempt
# TYPE platform_forge_restic_maintenance_last_run_timestamp gauge
platform_forge_restic_maintenance_last_run_timestamp ${end_ts}
# HELP platform_forge_restic_maintenance_last_success_timestamp Unix timestamp of the last successful maintenance
# TYPE platform_forge_restic_maintenance_last_success_timestamp gauge
platform_forge_restic_maintenance_last_success_timestamp ${last_success}
# HELP platform_forge_restic_maintenance_duration_seconds Duration of the last maintenance attempt
# TYPE platform_forge_restic_maintenance_duration_seconds gauge
platform_forge_restic_maintenance_duration_seconds $((end_ts - START_TS))
EOF
  mv -f "${METRICS_TMP}" "${METRICS_FILE}"
}

trap 'exit_code=$?; write_metrics "${exit_code}"' EXIT

exec 9>"{{ restic_lock_file }}"
flock -n 9 || { echo "ERROR: another Restic operation is running" >&2; exit 1; }

{% if restic_retention | length > 0 %}
restic \
{% for option in restic_options %}  {{ option | quote }} \
{% endfor %}  forget \
{% for tag in restic_tags %}  --tag {{ tag | quote }} \
{% endfor %}{% for key, value in restic_retention.items() %}  --{{ key | replace('_', '-') }} {{ value | int }}{% if not loop.last %} \
{% endif %}{% endfor %}
{% endif %}

{% if restic_prune_enabled | bool %}
restic \
{% for option in restic_options %}  {{ option | quote }} \
{% endfor %}  prune
{% endif %}
