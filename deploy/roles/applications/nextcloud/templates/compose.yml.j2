services:

  nextcloud:
    image: "{{ nextcloud_image }}"
    container_name: "{{ nextcloud_container_name }}"
    restart: unless-stopped

    volumes:
      - "{{ nextcloud_data_dir }}/html:/var/www/html"

    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ nextcloud_network_proxy }}"

      - "traefik.http.routers.nextcloud.rule=Host(`{{ nextcloud_hostname }}`)"
      - "traefik.http.routers.nextcloud.entrypoints=websecure"
      - "traefik.http.routers.nextcloud.tls=true"

{% if traefik_tls_mode == "acme" %}
      - "traefik.http.routers.nextcloud.tls.certresolver={{ traefik_acme_resolver }}"
{% endif %}

      - "traefik.http.services.nextcloud.loadbalancer.server.port=80"

    networks:
      - proxy

networks:

  proxy:
    external: true
    name: "{{ nextcloud_network_proxy }}"