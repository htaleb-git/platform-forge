#!/usr/bin/env bash
set -euo pipefail

BACKUP_DIR="{{ backup_n8n_dir }}"
DUMP_FILE="${BACKUP_DIR}/n8n.dump"

if [[ ! -f "${DUMP_FILE}" ]]; then
  echo "ERROR: n8n dump not found: ${DUMP_FILE}" >&2
  exit 1
fi

if [[ ! -s "${DUMP_FILE}" ]]; then
  echo "ERROR: n8n dump is empty: ${DUMP_FILE}" >&2
  exit 1
fi

docker stop "{{ n8n_container_name }}"

docker exec "{{ n8n_postgres_container_name }}" \
  psql \
  -U "{{ n8n_postgres_user }}" \
  -d postgres \
  -c "DROP DATABASE IF EXISTS {{ n8n_postgres_db }};"

docker exec "{{ n8n_postgres_container_name }}" \
  psql \
  -U "{{ n8n_postgres_user }}" \
  -d postgres \
  -c "CREATE DATABASE {{ n8n_postgres_db }} OWNER {{ n8n_postgres_user }};"

docker exec -i "{{ n8n_postgres_container_name }}" \
  pg_restore \
  -U "{{ n8n_postgres_user }}" \
  -d "{{ n8n_postgres_db }}" \
  --no-owner \
  --no-privileges \
  < "${DUMP_FILE}"

docker start "{{ n8n_container_name }}"

echo "n8n restore completed successfully."