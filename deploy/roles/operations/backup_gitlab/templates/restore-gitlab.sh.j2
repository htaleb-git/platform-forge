#!/usr/bin/env bash
set -Eeuo pipefail

[[ $# -eq 1 ]] || { echo "Usage: $0 <validated-generation-directory>" >&2; exit 2; }
GENERATION_DIR="$1"
APPLICATION_DIR="${GENERATION_DIR}/{{ backup_gitlab_application_subdir }}"
CONFIG_DIR="${GENERATION_DIR}/{{ backup_gitlab_config_subdir }}"
METADATA_DIR="${GENERATION_DIR}/{{ backup_gitlab_metadata_subdir }}"
BACKUP_ARCHIVE="${APPLICATION_DIR}/{{ backup_gitlab_dump_name }}"
GITLAB_CONTAINER="{{ gitlab_container_name }}"
GITLAB_APP_DIR="{{ gitlab_app_dir }}"
GITLAB_DATA_DIR="{{ gitlab_data_store_dir }}"
GITLAB_CONFIG_DIR="{{ gitlab_config_dir }}"
ROLLBACK_DIR="{{ backup_gitlab_restore_dir }}/rollback-$(date -u +%Y%m%dT%H%M%SZ)-$$"
ROLLBACK_DATA="${ROLLBACK_DIR}/data"
ROLLBACK_CONFIG="${ROLLBACK_DIR}/config"
MUTATION_STARTED=0
ROLLBACK_READY=0
ROLLBACK_RUNNING=0

[[ "${GENERATION_DIR}" == /* && -d "${GENERATION_DIR}" && ! -L "${GENERATION_DIR}" ]] \
  || { echo "ERROR: restore source must be an explicit directory" >&2; exit 1; }
[[ -s "${BACKUP_ARCHIVE}" \
   && -s "${CONFIG_DIR}/gitlab.rb" \
   && -s "${CONFIG_DIR}/gitlab-secrets.json" \
   && -s "${METADATA_DIR}/{{ backup_gitlab_filename_metadata }}" \
   && -s "${METADATA_DIR}/{{ backup_gitlab_version_file }}" ]] \
  || { echo "ERROR: incomplete GitLab restore source" >&2; exit 1; }

ORIGINAL_BACKUP_FILENAME="$(tr -d '\r\n' < "${METADATA_DIR}/{{ backup_gitlab_filename_metadata }}")"
[[ "${ORIGINAL_BACKUP_FILENAME}" =~ ^[A-Za-z0-9._-]+_gitlab_backup\.tar$ ]] \
  || { echo "ERROR: unsafe GitLab backup filename metadata" >&2; exit 1; }
BACKUP_ID="${ORIGINAL_BACKUP_FILENAME%_gitlab_backup.tar}"

docker inspect "${GITLAB_CONTAINER}" >/dev/null
[[ "$(docker inspect -f '{{ "{{.State.Running}}" }}' "${GITLAB_CONTAINER}")" == "true" ]] \
  || { echo "ERROR: GitLab container is not running" >&2; exit 1; }
CURRENT_INFO="$(docker exec "${GITLAB_CONTAINER}" gitlab-rake gitlab:env:info)"
CURRENT_VERSION="$(awk '/GitLab information/{seen=1;next} seen && /^Version:/{print $2;exit}' <<< "${CURRENT_INFO}")"
BACKUP_VERSION="$(awk '/GitLab information/{seen=1;next} seen && /^Version:/{print $2;exit}' "${METADATA_DIR}/{{ backup_gitlab_version_file }}")"
[[ -n "${CURRENT_VERSION}" && "${CURRENT_VERSION}" == "${BACKUP_VERSION}" ]] \
  || { echo "ERROR: GitLab version mismatch or missing version metadata" >&2; exit 1; }
[[ "${GITLAB_DATA_DIR}" == "{{ gitlab_data_dir }}/"* && "${GITLAB_DATA_DIR}" != "{{ gitlab_data_dir }}" ]] \
  || { echo "ERROR: unsafe GitLab data directory" >&2; exit 1; }
[[ -d "${GITLAB_DATA_DIR}" && ! -L "${GITLAB_DATA_DIR}" \
   && -d "${GITLAB_CONFIG_DIR}" && ! -L "${GITLAB_CONFIG_DIR}" \
   && -f "${GITLAB_APP_DIR}/compose.yml" ]] \
  || { echo "ERROR: GitLab live paths are incomplete" >&2; exit 1; }
mkdir -p -- "{{ backup_gitlab_restore_dir }}"

rollback() {
  ROLLBACK_RUNNING=1
  echo "ERROR: GitLab restore failed; attempting filesystem rollback" >&2
  docker rm -f "${GITLAB_CONTAINER}" >/dev/null 2>&1 || true
  find "${GITLAB_DATA_DIR}" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + \
    && cp -a -- "${ROLLBACK_DATA}/." "${GITLAB_DATA_DIR}/" \
    && cp -a -- "${ROLLBACK_CONFIG}/gitlab.rb" "${GITLAB_CONFIG_DIR}/gitlab.rb" \
    && cp -a -- "${ROLLBACK_CONFIG}/gitlab-secrets.json" "${GITLAB_CONFIG_DIR}/gitlab-secrets.json" \
    && chmod 0600 "${GITLAB_CONFIG_DIR}/gitlab-secrets.json" \
    && docker compose -f "${GITLAB_APP_DIR}/compose.yml" up -d gitlab \
    || { echo "CRITICAL: GitLab rollback failed; manual recovery is required" >&2; return 1; }
}

on_exit() {
  local exit_code=$?
  if [[ "${exit_code}" -ne 0 && "${MUTATION_STARTED}" -eq 1 \
     && "${ROLLBACK_READY}" -eq 1 && "${ROLLBACK_RUNNING}" -eq 0 ]]; then
    rollback || exit 2
  fi
  exit "${exit_code}"
}
trap on_exit EXIT

mkdir -- "${ROLLBACK_DIR}" "${ROLLBACK_DATA}" "${ROLLBACK_CONFIG}"
cp -a -- "${GITLAB_DATA_DIR}/." "${ROLLBACK_DATA}/"
cp -a -- "${GITLAB_CONFIG_DIR}/gitlab.rb" "${ROLLBACK_CONFIG}/gitlab.rb"
cp -a -- "${GITLAB_CONFIG_DIR}/gitlab-secrets.json" "${ROLLBACK_CONFIG}/gitlab-secrets.json"
chmod 0700 "${ROLLBACK_DIR}" "${ROLLBACK_DATA}" "${ROLLBACK_CONFIG}"
chmod 0600 "${ROLLBACK_CONFIG}/gitlab-secrets.json"
ROLLBACK_READY=1

docker stop "${GITLAB_CONTAINER}" >/dev/null
docker rm "${GITLAB_CONTAINER}" >/dev/null
MUTATION_STARTED=1
find "${GITLAB_DATA_DIR}" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
install -m 0644 "${CONFIG_DIR}/gitlab.rb" "${GITLAB_CONFIG_DIR}/gitlab.rb"
install -m 0600 "${CONFIG_DIR}/gitlab-secrets.json" "${GITLAB_CONFIG_DIR}/gitlab-secrets.json"
docker compose -f "${GITLAB_APP_DIR}/compose.yml" up -d gitlab

READY=0
for _ in $(seq 1 60); do
  if docker exec "${GITLAB_CONTAINER}" gitlab-ctl status >/dev/null 2>&1; then READY=1; break; fi
  sleep 10
done
[[ "${READY}" -eq 1 ]] || { echo "ERROR: GitLab did not initialize in time" >&2; exit 1; }
docker exec "${GITLAB_CONTAINER}" gitlab-ctl reconfigure
docker cp "${BACKUP_ARCHIVE}" "${GITLAB_CONTAINER}:/var/opt/gitlab/backups/${ORIGINAL_BACKUP_FILENAME}"
docker exec "${GITLAB_CONTAINER}" chown git:git "/var/opt/gitlab/backups/${ORIGINAL_BACKUP_FILENAME}"
docker exec "${GITLAB_CONTAINER}" gitlab-ctl stop puma
docker exec "${GITLAB_CONTAINER}" gitlab-ctl stop sidekiq
docker exec -e GITLAB_ASSUME_YES=1 "${GITLAB_CONTAINER}" gitlab-backup restore "BACKUP=${BACKUP_ID}"
docker restart "${GITLAB_CONTAINER}" >/dev/null

HEALTHY=0
for _ in $(seq 1 60); do
  HEALTH="$(docker inspect -f '{{ "{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}" }}' "${GITLAB_CONTAINER}" 2>/dev/null || true)"
  if [[ "${HEALTH}" == "healthy" || "${HEALTH}" == "running" ]]; then HEALTHY=1; break; fi
  sleep 10
done
[[ "${HEALTHY}" -eq 1 ]] || { echo "ERROR: restored GitLab did not become healthy" >&2; exit 1; }
docker exec "${GITLAB_CONTAINER}" gitlab-rake gitlab:check SANITIZE=true
MUTATION_STARTED=0
echo "GitLab restore and local validation completed successfully"
