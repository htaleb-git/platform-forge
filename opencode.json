{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "share": "disabled",
  "autoupdate": false,
  "snapshot": false,
  "formatter": false,
  "lsp": false,
  "permission": {
    "external_directory": "deny",
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "todowrite": "allow",
    "question": "allow",
    "skill": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch --list*": "allow",
      "git remote -v*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "git tag*": "deny",
      "git init*": "deny",
      "git remote add*": "deny",
      "git remote set-url*": "deny",
      "git remote remove*": "deny",
      "gh *": "deny",
      "ansible-playbook*": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "sftp *": "deny",
      "rsync *": "deny",
      "docker *": "deny",
      "docker-compose *": "deny",
      "podman *": "deny",
      "apt *": "deny",
      "apt-get *": "deny",
      "dnf *": "deny",
      "yum *": "deny",
      "pacman *": "deny",
      "apk *": "deny",
      "pip *": "deny",
      "pip3 *": "deny",
      "python -m pip *": "deny",
      "python3 -m pip *": "deny",
      "ansible-galaxy *": "deny",
      "npm install*": "deny",
      "npm i*": "deny",
      "pnpm install*": "deny",
      "pnpm add*": "deny",
      "yarn add*": "deny",
      "bun install*": "deny",
      "bun add*": "deny",
      "sudo *": "deny",
      "su *": "deny",
      "systemctl *": "deny",
      "service *": "deny",
      "mount *": "deny",
      "umount *": "deny",
      "reboot*": "deny",
      "shutdown*": "deny",
      "poweroff*": "deny",
      "rm *": "deny"
    }
  }
}
